# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# Flask session signing key (any long random string)
SECRET_KEY=change-me

# Google Maps JavaScript API key (route map on /route/<load_id> and /load/<load_id>)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Generative AI (Gemini) key used by the in-app chatbot (app.py exits if unset)
GOOGLE_GENAI_API_KEY=your-google-genai-api-key

# Trimble PC*MILER REST API key (mileage, tolls, GHG, directions, route map images)
PCMILER_API_KEY=your-pcmiler-api-key

# AWS credentials with read access to the DynamoDB tables `load_postings` and `load_stops` (region us-east-2)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
